{
  "type": "string",
  "pattern": "^((?:sans-date|[0-9]{4}(?:-env|-[0-9]{4}|-[0-9]{2}(?:-[0-9]{2})?)?))_([a-z0-9]+(?:-[a-z0-9]+)*)_(D(?!000000)[0-9]{6})(?:_((?:original|recto|verso|consultation|(?:restauree|colorisee|recadree)-v(?:0[1-9]|[1-9][0-9]+))))?\\.(jpg|jpeg|tif|tiff|png|heic|heif|dng|cr2|cr3|nef|arw|raf|orf|rw2|pef|srw|raw|avif|webp|jxl|gif|bmp)$(?![\\s\\S])",
  "description": "Date de prise de vue, description, identifiant et variante facultative. Les dates et liens d’inventaire sont contrôlés par le validateur.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
