    },
    "code_principal": {
      "type": "string",
      "pattern": "^(?:1[12]*|X(?!000000)[0-9]{6})(?:-U(?:0[1-9]|[1-9][0-9]+)-E(?:0[1-9]|[1-9][0-9]+)|-[DC](?:0[1-9]|[1-9][0-9]+)|-P[12]|~[1-9][0-9]*)*$(?![\\s\\S])"
    }
  },
  "required": [
    "personne_gedcom",
    "code_alternatif",
    "code_principal"
